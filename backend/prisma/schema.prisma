generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  SENIOR_OFFICIAL
  STAFF
}

enum RiskLevel {
  HIGH
  MEDIUM
  LOW
}

enum StakeholderResponsiveness {
  HIGH
  MEDIUM
  LOW
}

enum ProjectType {
  HIGHWAY
  RAILWAY
  IRRIGATION
  POWER
  INDUSTRIAL
  OTHER
}

enum DelayStatus {
  DELAYED
  ON_TIME
}

enum ProjectStage {
  NOTIFICATION
  APPROVAL
  LAND_ACQUISITION
  COMPENSATION
  REHABILITATION
  POSSESSION
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  DISMISSED
  COMPLETED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum AlertSeverity {
  HIGH
  MEDIUM
  LOW
}

enum PredictionStatus {
  PENDING
  DONE
  FAILED
}

// ─────────────────────────────
// MODELS
// ─────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          Role
  is_active     Boolean  @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // RBAC relations
  permissions         UserPermission[]
  project_assignments ProjectAssignment[]

  // Legacy relations (kept until migration 2)
  managed_projects      Project[]              @relation("ManagedProjects")
  administered_projects Project[]              @relation("AdministeredProjects")

  recorded_status_updates ProjectStatusHistory[]
  audit_logs              AuditLog[]
  imports                 ImportHistory[]
  alerts                  Alert[]

  @@map("users")
}

model Project {
  id                           Int      @id @default(autoincrement())
  project_id                   String   @unique
  project_type                 ProjectType?
  land_area_hectares           Float?
  number_of_affected_families  Int?
  compensation_status          String?
  approval_timeline_days       Int?
  legal_disputes_count         Int?     @default(0)
  possession_status            String?
  rehabilitation_progress_pct  Float?
  stakeholder_responsiveness   StakeholderResponsiveness?
  historical_performance_score Float?
  // Legacy columns — removed in migration 2
  administrator_id             Int?
  project_manager_id           Int?
  manager                      String?
  location                     String?
  state                        String?
  district                     String?
  altitude_m                   Float?
  latitude                     Float?
  longitude                    Float?
  delay_status                 DelayStatus?
  delay_days                   Int?
  risk_score                   Float?
  current_stage                ProjectStage?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Legacy relations — removed in migration 2
  administrator   User? @relation("AdministeredProjects", fields: [administrator_id], references: [id])
  project_manager User? @relation("ManagedProjects", fields: [project_manager_id], references: [id])

  // RBAC back-relation
  project_assignments ProjectAssignment[]

  status_history   ProjectStatusHistory[]
  risk_predictions RiskPrediction[]
  recommendations  Recommendation[]
  alerts           Alert[]

  @@map("projects")
  @@index([risk_score])
  @@index([project_type])
  @@index([state])
  @@index([district])
  @@index([project_manager_id])
}

model ProjectAssignment {
  id         Int     @id @default(autoincrement())
  project_id Int
  user_id    Int
  project    Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([project_id])
  @@index([user_id])
  @@map("project_assignments")
}

model UserPermission {
  id       Int    @id @default(autoincrement())
  user_id  Int
  resource String
  action   String
  user     User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, resource, action])
  @@map("user_permissions")
}

model ProjectStatusHistory {
  id                           Int      @id @default(autoincrement())
  project_id                   Int
  stage                        ProjectStage?
  compensation_status          String?
  approval_timeline_days       Int?
  legal_disputes_count         Int?
  possession_status            String?
  rehabilitation_progress_pct  Float?
  stakeholder_responsiveness   StakeholderResponsiveness?
  recorded_by                  Int?
  recorded_at                  DateTime @default(now())

  project          Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  recorded_by_user User?   @relation(fields: [recorded_by], references: [id])

  @@map("project_status_history")
  @@index([project_id])
}

model RiskPrediction {
  id                Int       @id @default(autoincrement())
  project_id        Int
  risk_score        Float?
  risk_level        RiskLevel?
  top_factors       Json?
  model_version     String?
  predicted_at      DateTime  @default(now())

  status            PredictionStatus?
  started_at        DateTime?
  finished_at       DateTime?
  error_message     String?          @db.VarChar(500)

  project         Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  stage_risks     StageRisk[]
  recommendations Recommendation[]

  @@map("risk_predictions")
  @@index([project_id])
  @@index([predicted_at])
}

model StageRisk {
  id            Int          @id @default(autoincrement())
  prediction_id Int
  stage         ProjectStage
  risk          Float

  prediction RiskPrediction @relation(fields: [prediction_id], references: [id], onDelete: Cascade)

  @@map("stage_risks")
  @@index([prediction_id])
}

model Recommendation {
  id             Int                  @id @default(autoincrement())
  project_id     Int
  prediction_id  Int?
  recommendation String
  priority       Priority
  status         RecommendationStatus @default(PENDING)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt

  project    Project         @relation(fields: [project_id], references: [id], onDelete: Cascade)
  prediction RiskPrediction? @relation(fields: [prediction_id], references: [id])

  @@map("recommendations")
  @@index([project_id])
  @@index([status])
}

model Alert {
  id         Int           @id @default(autoincrement())
  project_id Int
  user_id    Int?
  type       String
  message    String
  severity   AlertSeverity
  is_read    Boolean       @default(false)
  created_at DateTime      @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [user_id], references: [id])

  @@map("alerts")
  @@index([project_id])
  @@index([user_id])
  @@index([is_read])
  @@index([severity])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  role        String?
  action      String
  resource    String?
  resource_id Int?
  // Legacy column: kept for rows written before this migration
  project_id  Int?
  details     Json?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

model ImportHistory {
  id              Int      @id @default(autoincrement())
  file_name       String
  total_rows      Int
  successful_rows Int
  failed_rows     Int
  errors          Json?
  imported_by     Int?     @map("imported_by")
  created_at      DateTime @default(now())

  uploader User? @relation(fields: [imported_by], references: [id], onDelete: SetNull)

  @@map("import_history")
}
