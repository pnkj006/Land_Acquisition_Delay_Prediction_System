# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/land_acquisition_db?schema=public

# Auth
# Generate a secret using: openssl rand -hex 32
JWT_SECRET=your_32_character_jwt_secret_here
JWT_EXPIRES_IN=1d

# ML Service
ML_SERVICE_URL=http://localhost:8000
X_INTERNAL_TOKEN=your_internal_service_token_here

# Rate Limiting & Proxy settings
# TRUST_PROXY=1

# CORS Allowlist (comma separated)
CORS_ORIGINS=http://localhost:5173